DEBUG="True"
SECRET_KEY="your-secret-key"

ALLOWED_HOSTS="localhost,127.0.0.1"
CSRF_TRUSTED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# Superuser created on the first boot. Later boots report the name as taken
DJANGO_SUPERUSER_USERNAME="admin"
DJANGO_SUPERUSER_EMAIL="admin@example.com"
DJANGO_SUPERUSER_PASSWORD="change-me"

# Public base URL, used for links in emails. Leave empty to omit them
SITE_URL="http://127.0.0.1:8000"

# Public origin of the MCP server
MCP_BASE_URL="http://localhost:8000"

# Email (Anymail + Resend in prod; console backend in DEBUG)
# EMAIL_BACKEND="anymail.backends.resend.EmailBackend"
DEFAULT_FROM_EMAIL="WupNext <onboarding@resend.dev>"
RESEND_API_KEY=""

# Django Q2 cluster
Q_WORKERS="2"
Q_TIMEOUT="60"
Q_RETRY="120"
